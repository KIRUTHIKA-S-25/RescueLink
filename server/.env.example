PORT=5000
NODE_ENV=development

# MongoDB Atlas — fill in your connection string
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/rescuelink

# JWT — change this to a long random string in production
JWT_SECRET=rescuelink_dev_secret_change_in_production
JWT_EXPIRES_IN=7d

# Seed users — Phase 3 testing (run: node src/utils/seedUsers.js)
SEED_CITIZEN_EMAIL=
SEED_CITIZEN_PASSWORD=
SEED_RESPONDER_EMAIL=
SEED_RESPONDER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary — fill in after Phase 4
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Escalation timeout in milliseconds (300000 = 5 min, use 30000 = 30s for demo)
ESCALATION_TIMEOUT_MS=300000

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
