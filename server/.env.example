PORT=5000
NODE_ENV=development

# MongoDB Atlas — fill in after Phase 2
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rescuelink

# JWT — change this to a long random string in production
JWT_SECRET=rescuelink_dev_secret_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary — fill in after Phase 4
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Escalation timeout in milliseconds (300000 = 5 min, use 30000 = 30s for demo)
ESCALATION_TIMEOUT_MS=300000

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
